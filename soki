#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_directory="$(cd -P "$(dirname "$script_path")" >/dev/null 2>&1 && pwd)"
  link_target="$(readlink "$script_path")"
  if [[ "$link_target" == /* ]]; then
    script_path="$link_target"
  else
    script_path="$script_directory/$link_target"
  fi
done
cd -P "$(dirname "$script_path")"

if ! command -v uv >/dev/null 2>&1; then
  echo "soki code needs uv. Install it from https://docs.astral.sh/uv/"
  exit 1
fi

if [[ ! -x .venv/bin/python ]]; then
  echo "Preparing soki code for first launch..."
  uv sync
fi

printf '\033[38;2;167;183;255m'
echo "  ┏━┓ ┏━┓ ╻┏ ╻    ┏━╸ ┏━┓ ┏━┓ ┏━╸"
echo "  ┗━┓ ┃ ┃ ┣┻┓┃    ┃   ┃ ┃ ┃ ┃ ┣╸ "
echo "  ┗━┛ ┗━┛ ╹ ╹╹    ┗━╸ ┗━┛ ┗━┛ ┗━╸"
printf '\033[0m'
printf '\033[38;2;125;132;148m  local agent · research and paper trading\n\033[0m'
echo ""

mode="${1:-desktop}"
if [[ "$#" -gt 0 ]]; then
  shift
fi

case "$mode" in
  desktop|web)
    exec ./infrastructure/scripts/run.sh "$@"
    ;;
  terminal)
    exec ./infrastructure/scripts/terminal-run.sh "$@"
    ;;
  android-link)
    exec make android-link
    ;;
  android-install)
    exec make android-install
    ;;
  *)
    echo "Usage: ./soki [desktop|terminal|android-link|android-install]"
    exit 2
    ;;
esac
