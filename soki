#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_directory="$(cd -P "$(dirname "$script_path")" >/dev/null 2>&1 && pwd)"
  link_target="$(readlink "$script_path")"
  if [[ "$link_target" == /* ]]; then
    script_path="$link_target"
  else
    script_path="$script_directory/$link_target"
  fi
done
cd -P "$(dirname "$script_path")"

if ! command -v uv >/dev/null 2>&1; then
  echo "Soki Trade needs uv. Install it from https://docs.astral.sh/uv/"
  exit 1
fi

if [[ ! -x .venv/bin/python ]]; then
  echo "Preparing Soki Trade for first launch..."
  uv sync
fi

exec ./infrastructure/scripts/terminal-run.sh
