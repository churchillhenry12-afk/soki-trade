QFORGE_DATABASE_URL=sqlite:///./data/qforge.db
QFORGE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://soki-trade-agent.vercel.app
QFORGE_DEMO_MODE=false
QFORGE_REDIS_URL=redis://127.0.0.1:6379/0
QFORGE_PROVIDER_CONFIG_PATH=data/provider-config.json
QFORGE_GATEWAY_CONFIG_PATH=data/gateway-config.json
QFORGE_MARKET_DATA_DIRECTORY=data/market

# Hermes Agent runtime. Start Hermes's authenticated API server and point soki code
# at it. The same key must be configured as API_SERVER_KEY in Hermes.
QFORGE_HERMES_URL=http://127.0.0.1:8642
QFORGE_HERMES_API_KEY=
QFORGE_HERMES_MODEL=hermes
QFORGE_HERMES_TIMEOUT_SECONDS=180

# Model routing. The first slice uses the mock provider.
QFORGE_RESEARCH_DIRECTOR_PROVIDER=mock
QFORGE_RESEARCH_DIRECTOR_MODEL=deterministic-mock
QFORGE_CRITIC_PROVIDER=mock
QFORGE_CRITIC_MODEL=deterministic-mock

# Future Windows bridge. Do not put a real secret in this file.
QFORGE_MT5_BRIDGE_URL=https://windows-demo-bridge.example.invalid
QFORGE_MT5_API_TOKEN=
QFORGE_MT5_HMAC_SECRET=
